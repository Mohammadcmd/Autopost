# Ingestion
# Comma-separated list of folders to treat like removable storage. Useful for
# testing without real hardware, and for cameras/cards that always mount at a
# fixed path.
WATCH_PATHS=
POLL_INTERVAL_SECONDS=3
MIN_PHOTOS_PER_EVENT=1
MAX_LOOKBACK_DAYS=365
BURST_GAP_MINUTES=45

# Storage (defaults to a local SQLite file + backend/data/media)
DATABASE_URL=
AUTOPOST_DATA_DIR=

# Events website (leave blank to use the local sample_events.json stub)
EVENTS_WEBSITE_BASE_URL=
EVENTS_WEBSITE_API_KEY=
STUB_EVENTS_FILE=

# Meta Graph API (Instagram + Facebook). Leave blank to run in dry-run mode.
META_ACCESS_TOKEN=
META_PAGE_ID=
IG_BUSINESS_ACCOUNT_ID=
GRAPH_API_BASE_URL=https://graph.facebook.com/v19.0
# Publicly reachable base URL for this app, required for real (non-dry-run)
# Instagram posts since Instagram fetches image_url itself.
PUBLIC_BASE_URL=

# Set to "true" to auto-watch for removable storage on startup.
AUTO_WATCH=false
